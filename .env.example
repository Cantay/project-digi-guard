# .env olarak kopyalayın. Bu dosya repoya girmez.
SITE_DOMAIN=www.digi-guard.com
# Kök alan adı da aynı siteye gelsin (isteğe bağlı):
# EXTRA_HOST_RULE= || Host(`digi-guard.com`)
EXTRA_HOST_RULE=

# Traefik'in bağlı olduğu Docker ağı
PROXY_NETWORK=traefik

# Traefik Docker etiketleri: true yaparsanız yönlendirme kendiliğinden kurulur.
TRAEFIK_LABELS=false
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

TAG=latest
