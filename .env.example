# .env olarak kopyalayın. Bu dosya repoya girmez.
SITE_DOMAIN=www.digi-guard.com
# Sunucudaki nginx'in yönlendireceği yerel port (yalnızca 127.0.0.1'e açılır)
SITE_PORT=8088
# İletişim formu: e-posta hesabının SMTP bilgileri
SMTP_HOST=mail.digi-guard.com
# 587 = STARTTLS, 465 = TLS
SMTP_PORT=587
SMTP_USER=kurumsal@digi-guard.com
SMTP_PASS=
# Gönderen adres (boşsa SMTP_USER); taleplerin gideceği adres
MAIL_FROM=
MAIL_TO=kurumsal@digi-guard.com

TAG=latest
